{
  "name": "backend",
  "version": "1.0.0",
  "description": "CEIR backend microservices. docker:* scripts = Windows local only. Linux production = host PostgreSQL + Redis (no Docker).",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:gateway": "tsx services/api-gateway/src/index.ts",
    "dev:bff": "tsx services/bff/src/index.ts",
    "dev:swagger": "tsx services/swagger-service/src/index.ts",
    "dev:auth": "tsx services/auth-service/src/index.ts",
    "dev:users": "tsx services/users-service/src/index.ts",
    "dev:devices": "tsx services/devices-service/src/index.ts",
    "dev:tax": "tsx services/tax-service/src/index.ts",
    "dev:payments": "tsx services/payments-service/src/index.ts",
    "dev:claims": "tsx services/claims-service/src/index.ts",
    "dev:activities": "tsx services/activities-service/src/index.ts",
    "dev:nrc": "tsx services/nrc-service/src/index.ts",
    "dev": "npm run dev:all",
    "dev:all": "concurrently -n gateway,bff,swagger,auth,users,devices,tax,payments,claims,activities,nrc -c blue,magenta,cyan,green,yellow,cyan,red,white,gray,blueBright,greenBright \"npm:dev:gateway\" \"npm:dev:bff\" \"npm:dev:swagger\" \"npm:dev:auth\" \"npm:dev:users\" \"npm:dev:devices\" \"npm:dev:tax\" \"npm:dev:payments\" \"npm:dev:claims\" \"npm:dev:activities\" \"npm:dev:nrc\"",
    "pm2:start": "node -e \"require('fs').mkdirSync('logs',{recursive:true})\" && pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs",
    "pm2:delete": "pm2 delete ecosystem.config.cjs",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs",
    "pm2:flush": "pm2 flush",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:pm2": "npm run pm2:start",
    "db:migrate": "tsx database/migrate.ts",
    "db:seed": "tsx database/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "docker:db": "docker compose -f database/docker-compose.yml up -d",
    "docker:db:down": "docker compose -f database/docker-compose.yml down",
    "docker:redis": "docker compose -f redis/docker-compose.yml up -d",
    "docker:redis:down": "docker compose -f redis/docker-compose.yml down",
    "docker:infra": "docker compose -f docker-compose.infra.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.infra.yml down",
    "local:infra": "npm run docker:infra",
    "local:infra:down": "npm run docker:infra:down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.11.1",
    "pg": "^8.22.0",
    "pm2": "^6.0.14",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
