PORT=3000
ARCHITECTURE=microservices
DOMAIN_SERVICES=auth,users,devices,tax,payments,claims,activities,nrc

# Infra policy:
#   Windows local  → Docker (npm run docker:infra); defaults below match compose
#   Linux production → host PostgreSQL + Redis (no Docker); edit DB_* / REDIS_* / URLs

# PostgreSQL
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_DATABASE=app_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app_db
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

GATEWAY_PORT=3000
GATEWAY_URL=http://localhost:3000
SWAGGER_PORT=3001
BFF_PORT=3002
BFF_URL=http://localhost:3002
# REQUIRED: strong secret (>=32 chars). Never use change-me-in-production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=local-dev-only-replace-before-production-use-32chars-min
# Access JWT + session lifetime (default 7 days)
ACCESS_TOKEN_TTL_SEC=604800
# Local only (never on production): ALLOW_WEAK_JWT=true
SWAGGER_ENABLED=true
SWAGGER_DEMO_HINTS=false
# Production: SWAGGER_ENABLED=false (default when NODE_ENV=production)
# Browser CORS allowlist (comma-separated). Production should set this.
# CORS_ORIGINS=https://service.ceir.gov.mm,https://app.ceir.gov.mm
AUTH_SERVICE_PORT=3010
AUTH_SERVICE_URL=http://localhost:3010
USERS_SERVICE_PORT=3011
USERS_SERVICE_URL=http://localhost:3011
DEVICES_SERVICE_PORT=3012
DEVICES_SERVICE_URL=http://localhost:3012
TAX_SERVICE_PORT=3013
TAX_SERVICE_URL=http://localhost:3013
PAYMENTS_SERVICE_PORT=3014
PAYMENTS_SERVICE_URL=http://localhost:3014
CLAIMS_SERVICE_PORT=3015
CLAIMS_SERVICE_URL=http://localhost:3015
ACTIVITIES_SERVICE_PORT=3016
ACTIVITIES_SERVICE_URL=http://localhost:3016
NRC_SERVICE_PORT=3017
NRC_SERVICE_URL=http://localhost:3017
